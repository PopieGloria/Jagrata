# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/*


# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Configuration Files (SENSITIVE - DO NOT COMMIT)
/lib/firebase_options.dart
/lib/firebase_options_web.dart
/lib/firebase_options_ios.dart
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/firebase-debug.log

# Genkit AI Configuration Files (SENSITIVE - DO NOT COMMIT)
/genkit-ai/config.js

# Environment files (protect actual env files, but allow templates)
.env
.env.local
.env.production
!.env.template

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Other sensitive files
*.key
*.pem
*.p12
*.mobileprovision 